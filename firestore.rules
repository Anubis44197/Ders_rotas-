rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /families/ders-tak-main/state/current {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if false;
    }

    match /families/ders-tak-main/state/{sectionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.schemaVersion == 2
        && request.resource.data.syncVersion == 3
        && request.resource.data.keys().hasOnly(['schemaVersion', 'syncVersion', 'value', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /families/ders-tak-main/taskChunks/{chunkId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.schemaVersion == 2
        && request.resource.data.syncVersion == 3
        && request.resource.data.keys().hasOnly(['schemaVersion', 'syncVersion', 'chunkIndex', 'chunkSize', 'totalChunks', 'value', 'updatedAt', 'updatedBy']);
      allow delete: if request.auth != null;
    }
  }
}
